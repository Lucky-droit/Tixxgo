{
    "name": "tixxgo-serverside",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/src/server.js",
        "migrate": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
        "migrate:rollback": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:rollback",
        "seed": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:run",
        "test": "vitest run"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "knex": "^3.1.0",
        "pg": "^8.16.0",
        "pino": "^9.6.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/express": "^5.0.1",
        "@types/node": "^22.13.10",
        "@types/supertest": "^6.0.2",
        "supertest": "^7.1.0",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2",
        "vitest": "^3.0.8"
    }
}